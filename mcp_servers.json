{
    "mcp_servers": {
      "time": {
        "command": "uvx",
        "args": ["mcp-server-time", "--local-timezone=Asia/Shanghai"]
      },
      "ddg-search": {
        "command": "uvx",
        "args": ["duckduckgo-mcp-server"]
      },
      "komugi-context": {
        "command": "uv",
        "args": [
          "run",
          "python",
          "scripts/komugi_context_mcp_server.py"
        ]
      }
    }
}
